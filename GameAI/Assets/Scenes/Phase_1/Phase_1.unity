MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1513515564}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e88b0b3e8547da640bb2f0a7e6db7e83, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  objectSaveID: Computer_Phase1
  computerPanel: {fileID: 280353344}
  menuScreen: {fileID: 2014931240}
  detailScreen: {fileID: 443665993}
  closeButton: {fileID: 472517977}
  titleTextUI: {fileID: 1539774068}
  bodyTextUI: {fileID: 379805847}
  title1: Reconhecimento de fala
  body1: "O reconhecimento de fala \xE9 uma aplica\xE7\xE3o onde a IA consegue reconhecer
    o que est\xE1 sendo falado por um humano.\r\nEssa aplica\xE7\xE3o \xE9 muito
    usada quando h\xE1 a gera\xE7\xE3o de legendas autom\xE1ticas em v\xEDdeos ou
    quando voc\xEA faz um pedido para uma IA a partir de um \xE1udio. A IA \xE9 capaz
    de reconhecer, interpretar e responder o seu pedido\r\n"
  title2: Reconhecimento de imagem
  body2: "O reconhecimento de imagem utilizando Intelig\xEAncia Artificial est\xE1
    presente quando acessamos um aplicativo de fotos e queremos encontrar todas as
    fotos em que voc\xEA est\xE1 presente!\r\nNa barra de pesquisa voc\xEA consegue
    selecionar uma foto sua e o aplicativo vai te mostrar apenas fotos com voc\xEA!\r\nEsse
    reconhecimento \xE9 feito utilizando as suas fotos e identificando padr\xF5es
    entre as pessoas. Assim, o aplicativo \xE9 capaz de reconhecer quando a mesma
    pessoa est\xE1 em 2 fotos diferentes.\r\n"
  title3: "Classifica\xE7\xE3o de emails"
  body3: "Nos nossos e-mails recebemos diariamente propagandas ou at\xE9 mesmo e-mails
    de fraudes, que s\xE3o enviados em massa, eles s\xE3o os \u201Cspams\u201D. Gra\xE7as
    aos sistemas de classifica\xE7\xE3o de e-mails, esses emails n\xE3o poluem a
    nossa Caixa de Entrada, fazendo com que a gente consiga ter mais aten\xE7\xE3o
    aos emails que s\xE3o importantes!\n\nMas cuidado, toda Intelig\xEAncia Artificial
    pode cometer erros, por isso que sempre que voc\xEA estiver esperando um email
    importante, \xE9 recomendado que voc\xEA verifique o seu spam!\n"
  xpAmount: 2
  topics: 3
  onCloseComputer:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1513515569}
        m_TargetAssemblyTypeName: InteractionTrigger, Assembly-CSharp
        m_MethodName: ResetInteraction
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
