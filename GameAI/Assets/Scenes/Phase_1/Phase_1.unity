  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Nos nossos e-mails recebemos diariamente propagandas ou at\xE9 mesmo e-mails
    de fraudes, que s\xE3o enviados em massa, eles s\xE3o os \u201Cspams\u201D. Gra\xE7as
    aos sistemas de classifica\xE7\xE3o de e-mails, esses emails n\xE3o poluem a
    nossa Caixa de Entrada, fazendo com que a gente consiga ter mais aten\xE7\xE3o
    aos emails que s\xE3o importantes!\n\nMas cuidado, toda Intelig\xEAncia Artificial
    pode cometer erros, por isso que sempre que voc\xEA estiver esperando um email
    importante, \xE9 recomendado que voc\xEA verifique o seu spam!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
